{
  "name": "ev_rest",
  "version": "1.0.0",
  "description": "This is the rest api for EV Kiosk",
  "main": "dist/index.js",
  "targets": {
    "main": {
      "context": "node",
      "includeNodeModules": true,
      "sourceMap": false,
      "distDir": "./dist",
      "engines": {
        "node": ">= 18"
      }
    }
  },
  "scripts": {
    "start": "nodemon --ignore test.js index.js",
    "build": "parcel build index.js --dist-dir ./dist",
    "serve": "node dist/index.js",
    "lint": "eslint .",
    "test": "jest"
  },
  "author": "Basavaraj Senseops",
  "license": "ISC",
  "dependencies": {
    "@types/jest": "^29.5.14",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mssql": "^11.0.1",
    "parcel": "^2.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@parcel/optimizer-terser": "^2.13.3",
    "eslint": "^9.11.1",
    "globals": "^15.9.0",
    "jest": "^29.7.0"
  }
}
